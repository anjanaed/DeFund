# Environment
NODE_ENV=development
PORT=3000

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=defund
# Pooler/app connection URL (used by PrismaService at runtime)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/defund
# Direct connection URL (used by Prisma CLI for migrations — same as DATABASE_URL for local, different for Supabase)
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/defund

# Blockchain
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
CAMPAIGN_FACTORY_ADDRESS=
USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# Starting block for event listening (deploy block number)
START_BLOCK=0

# JWT Secret (for authentication)
JWT_SECRET=your-secret-key-change-in-production

# Operator wallet private key — used by the backend keeper to auto-finalize expired milestone voting.
# This wallet only needs ETH for gas; it calls a permissionless function so no privileged role is required.
OPERATOR_PRIVATE_KEY=

# IPFS
IPFS_GATEWAY=https://ipfs.io/ipfs/

# Social OAuth — register apps on each platform to get these keys
# Callback URIs must match exactly what you register (change host for production)

# GitHub: github.com → Settings → Developer Settings → OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/github/callback

# Discord: discord.com/developers/applications → OAuth2 → Redirects
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# Twitter/X: developer.twitter.com → Project → App → OAuth 2.0
# Enable "OAuth 2.0", set Type to "Web App", add the callback URI below
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:3000/api/auth/twitter/callback
