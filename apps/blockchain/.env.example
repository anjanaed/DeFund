# Deployer wallet private key (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Sepolia RPC URL — get one free from Alchemy or Infura
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_api_key_here

# USDC on Sepolia testnet (Circle's official address)
USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# Optional: Etherscan API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here
